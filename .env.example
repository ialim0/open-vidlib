# ─────────────────────────────────────────────
# GandaLab — environment variables
# Copy this file to .env and fill in the blanks.
# Never commit .env to source control.
# ─────────────────────────────────────────────

# PostgreSQL (must match the values in docker-compose.yml)
POSTGRES_DB=gandalab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

DATABASE_URL=postgresql://postgres:changeme@localhost:5432/gandalab

# ─── Mistral AI ─────────────────────────────
# Required for semantic search, RAG Q&A, translation, and Voxtral TTS.
# Get your key → https://console.mistral.ai
# Without a key the app still runs; AI features return graceful fallbacks.
MISTRAL_API_KEY=

# Override these only if you want to pin specific model versions
# MISTRAL_EMBED_MODEL=mistral-embed
# MISTRAL_LLM_MODEL=mistral-large-latest
# MISTRAL_TTS_MODEL=voxtral-mini-tts-2603

# ─── Frontend ───────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ─── CORS ───────────────────────────────────
# Comma-separated list of allowed origins for the backend
CORS_ORIGINS=http://localhost:3000
