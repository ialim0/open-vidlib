# ─────────────────────────────────────────────
# Open VidLib — environment variables
# Copy this file to .env and fill in the blanks.
# Never commit .env to source control.
# ─────────────────────────────────────────────

# PostgreSQL (must match the values in docker-compose.yml)
POSTGRES_DB=openvidlib
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

DATABASE_URL=postgresql://postgres:changeme@localhost:5432/openvidlib

# ─── LLM & Embedding Provider Selection ────────
# Choose provider: mistral (default), gemini, openai, ollama, or custom
# LLM_PROVIDER=mistral
# LLM_MODEL=mistral-small-latest
# EMBEDDING_PROVIDER=mistral
# EMBEDDING_MODEL=mistral-embed

# ─── Mistral AI (Default) ──────────────────────
# Default for multi-tool agent loop, embeddings, semantic search, RAG Q&A, and Voxtral TTS dubbing.
# Get your key → https://console.mistral.ai
# Without a key the app still runs; AI features return graceful fallbacks.
MISTRAL_API_KEY=

# Override these only if you want to pin specific model versions
# MISTRAL_EMBED_MODEL=mistral-embed
# MISTRAL_LLM_MODEL=mistral-small-latest
# MISTRAL_TTS_MODEL=voxtral-mini-tts-2603

# ─── Google Gemini (Optional Alternative) ──────
# Get your key → https://aistudio.google.com/
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=gemini-embedding-2

# ─── OpenAI (Optional Alternative) ─────────────
# Get your key → https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ─── DeepSeek (Optional Alternative) ───────────
# Get your key → https://platform.deepseek.com/
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# ─── Frontend ───────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ─── CORS ───────────────────────────────────
# Comma-separated list of allowed origins for the backend
CORS_ORIGINS=http://localhost:3000
